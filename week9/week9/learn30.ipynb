    "import tkinter as tk\n",
    "\n",
    "window = tk.Tk()\n",
    "window.title(\"신재중\")\n",
    "window.geometry(\"400x200\")\n",
    "\n",
    "label = tk.Label(window, text=\"Hello tkinter\")\n",
    "label.pack()\n",
    "\n",
    "window.mainloop() \n",
    "\n"
   ]
  }
